         "source": [
            "from sklearn.tree import DecisionTreeClassifier, plot_tree\n",
            "\n",
            "tree_preprocess = ColumnTransformer([\n",
            "    ('num', SimpleImputer(strategy='median'), num_cols),\n",
            "    ('cat', OneHotEncoder(handle_unknown='ignore'), cat_cols)  # all properties should have a type but unknown may carry information so gets its own type\n",
            "])\n",
            "\n",
            "tree_pipeline = Pipeline([\n",
            "    ('pre', tree_preprocess),\n",
            "    ('tree', DecisionTreeClassifier())\n",
            "])\n",
            "\n",
            "tree_grid = GridSearchCV(\n",
            "    tree_pipeline, {\n",
            "        'tree__criterion': ['entropy'],\n",
            "        'tree__max_depth': list(range(1, 36)) + [None]\n",
            "    },\n",
            "    cv=StratifiedKFold(n_splits=10, shuffle=True),\n",
            "    scoring='f1_macro', n_jobs=-1\n",
            ")\n",
            "\n",
            "tree_grid.fit(X_train, y_train)\n",
            "print('Best params:', tree_grid.best_params_, 'CV macro F1:', round(tree_grid.best_score_, 3))\n",
            "\n",
            "y_pred_tree = tree_grid.predict(X_test)\n",
            "\n",
            "plot_tree(tree_grid.best_estimator_.named_steps['tree'], max_depth=2, class_names=['single', 'multi'], filled=True)\n",
            "plt.show()\n"
         ]
