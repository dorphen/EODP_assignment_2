            "import numpy as np\n",
            "from itertools import combinations\n",
            "from sklearn.feature_selection import mutual_info_regression\n",
            "from sklearn.metrics import normalized_mutual_info_score\n",
            "\n",
            "NMI_MAX_BINS = 10\n",
            "NMI_SENSITIVITY_BINS = 5\n",
            "\n",
            "def quantile_bins(series, max_bins=10):\n",
            "    # Create a discrete number of bins for NMI\n",
            "    if series.nunique() < 2:\n",
            "        return np.zeros(len(series), dtype=int)\n",
            "    return pd.qcut(\n",
            "        series, q=min(max_bins, series.nunique()), labels=False, duplicates='drop'\n",
            "    ).to_numpy(dtype=int)\n",
            "\n",
            "def nmi_labels(series, variable_name, max_bins):\n",
            "    # Applies NMI normalisation to appropriate variables\n",
            "    if variable_name == 'is_multi_listing':\n",
            "        return series.to_numpy(dtype=int)\n",
            "    return quantile_bins(series, max_bins=max_bins)\n",
            "\n",
            "# Report effective bin count after handling ties\n",
            "bin_summary = pd.DataFrame([\n",
            "    {\n",
            "        'variable': variable,\n",
            "        'requested bins': NMI_MAX_BINS,\n",
            "        'effective bins': len(np.unique(quantile_bins(corr_df[variable], NMI_MAX_BINS))),\n",
            "    }\n",
            "    for variable in variables if variable != 'is_multi_listing'\n",
            "])\n",
            "display(bin_summary)\n",
            "\n",
            "results = []\n",
            "for left, right in combinations(variables, 2):\n",
            "    x, y = corr_df[left], corr_df[right]\n",
            "\n",
            "    # With a boolean target, Pearson is the valid point-biserial correlation.\n",
            "    pearson_r = x.corr(y, method='pearson')\n",
            "    spearman_rho = x.corr(y, method='spearman')\n",
            "\n",
            "    # kNN MI estimator: detects non-linear association and has no direction.\n",
            "    mi = mutual_info_regression(\n",
            "        x.to_numpy().reshape(-1, 1),\n",
            "        y.to_numpy(),\n",
            "        discrete_features=(left == 'is_multi_listing'),\n",
            "        random_state=42,\n",
            "    )[0]\n",
            "\n",
            "    # NMI needs discrete labels. Retain the binary target; quantile-bin the rest.\n",
            "    x_nmi = nmi_labels(x, left, NMI_MAX_BINS)\n",
            "    y_nmi = nmi_labels(y, right, NMI_MAX_BINS)\n",
            "    nmi = normalized_mutual_info_score(x_nmi, y_nmi, average_method='arithmetic')\n",
            "\n",
            "    # Sensitivity/robustness check: conclusions should not depend on the bin count.\n",
            "    nmi_5_bins = normalized_mutual_info_score(\n",
            "        nmi_labels(x, left, NMI_SENSITIVITY_BINS),\n",
            "        nmi_labels(y, right, NMI_SENSITIVITY_BINS),\n",
            "        average_method='arithmetic',\n",
            "    )\n",
            "\n",
            "    results.append({\n",
            "        'pair': f'{left} × {right}',\n",
            "        'n': len(corr_df),\n",
            "        'Pearson r': pearson_r,\n",
            "        'Spearman ρ': spearman_rho,\n",
            "        'Mutual information (nats)': mi,\n",
            "        'Normalised MI (up to 10 bins)': nmi,\n",
            "        'NMI sensitivity (up to 5 bins)': nmi_5_bins,\n",
            "    })\n",
            "\n",
            "correlation_results = pd.DataFrame(results)\n",
            "display(correlation_results.round(4))\n"
         ]
      },
