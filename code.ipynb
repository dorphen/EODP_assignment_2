            "\n",
            "n = len(y_pred)\n",
            "\n",
            "bootstrap = []\n",
            "for i in range(1000):  # bootstrap 1000 samples\n",
            "    sample_ids = random.choices(range(n), k=n)\n",
            "    bootstrap.append(f1_score([y_true[j] for j in sample_ids], [y_pred[j] for j in sample_ids],\n",
            "                         average='macro'))\n",
            "\n",
            "bootstrap.sort()\n",
            "p1 = bootstrap[int(0.025 * len(bootstrap))]\n",
            "p2 = bootstrap[int(0.975 * len(bootstrap)) - 1]\n",
            "print(f\"Test macro-F1 = {f1_score(y_true, y_pred, average='macro'):.3f}  95% CI [{p1:.3f}, {p2:.3f}]\")\n"
         ]
