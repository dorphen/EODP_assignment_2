            "from sklearn.model_selection import train_test_split, GridSearchCV, StratifiedKFold\n",
            "from sklearn.neighbors import KNeighborsClassifier\n",
            "from sklearn.metrics import confusion_matrix, ConfusionMatrixDisplay, make_scorer, f1_score\n",
            "from sklearn.preprocessing import StandardScaler, OneHotEncoder\n",
            "from sklearn.compose import ColumnTransformer\n",
            "from sklearn.pipeline import Pipeline\n",
            "from sklearn.impute import SimpleImputer\n",
            "import matplotlib.pyplot as plt\n",
            "\n",
            "num_cols = ['hosts_time_as_host_years',\n",
            "          'host_is_superhost',\n",
            "          'host_has_profile_pic',\n",
            "          'host_identity_verified',\n",
            "          'latitude',\n",
            "          'longitude',\n",
            "          'bedrooms_calculated',\n",
            "          'bathrooms_calculated',\n",
            "          'accommodates',\n",
            "          'price',\n",
            "          'minimum_nights',\n",
            "          'maximum_nights',\n",
            "          'number_of_reviews',\n",
            "          'review_scores_rating',\n",
            "          'review_scores_accuracy',\n",
            "          'review_scores_cleanliness',\n",
            "          'review_scores_checkin',\n",
            "          'review_scores_communication',\n",
            "          'review_scores_location',\n",
            "          'review_scores_value',\n",
            "          'reviews_per_month',\n",
            "          'availability_365']\n",
            "\n",
            "cat_cols = ['consolidated_property_type']\n",
            "\n",
            "X_train, X_test, y_train, y_test = train_test_split(\n",
            "    df[num_cols + cat_cols],\n",
            "    df['is_multi_listing'],\n",
            "    test_size = 0.2,\n",
            "    stratify=df['is_multi_listing']\n",
            ")\n",
            "\n",
            "knn_preprocess = ColumnTransformer([\n",
            "    ('num', Pipeline([\n",
            "        ('impute', SimpleImputer(strategy='median')),\n",
            "        ('scale', StandardScaler())\n",
            "    ]), num_cols),\n",
            "    ('cat', OneHotEncoder(handle_unknown='ignore'), cat_cols)  # all properties should have a type but unknown may carry information so gets its own type\n",
            "])\n",
            "\n",
            "knn_pipeline = Pipeline([\n",
            "    ('pre', knn_preprocess),\n",
            "    ('knn', KNeighborsClassifier())\n",
            "])\n",
            "\n",
            "knn_grid = GridSearchCV(\n",
            "    knn_pipeline, {\n",
            "        'knn__n_neighbors': list(range(1, 32)),\n",
            "        'knn__weights': ['uniform', 'distance']\n",
            "    },\n",
            "    cv=StratifiedKFold(n_splits=10, shuffle=True),\n",
            "    scoring='f1_macro', n_jobs=-1\n",
            ")\n",
            "\n",
            "knn_grid.fit(X_train, y_train)\n",
            "print('Best params:', knn_grid.best_params_, 'CV macro F1:', round(knn_grid.best_score_, 3))\n",
            "\n",
            "y_pred = knn_grid.predict(X_test)\n",
            "\n",
            "tested_hyperparams = pd.DataFrame(knn_grid.cv_results_)\n",
            "\n",
            "# TODO fix this up\n",
            "for w, g in tested_hyperparams.groupby('param_knn__weights'):\n",
            "    g = g.sort_values('param_knn__n_neighbors')\n",
            "    plt.errorbar(g['param_knn__n_neighbors'], g['mean_test_score'],\n",
            "                 yerr=g['std_test_score'], marker='o', capsize=3, label=w)\n",
            "plt.xlabel('k (n_neighbors)')\n",
            "plt.ylabel('Mean 10-fold CV F1')\n",
            "plt.legend(title='weights')\n",
            "plt.show()\n"
         ]
      },
